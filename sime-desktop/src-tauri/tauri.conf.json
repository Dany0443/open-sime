{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open SIME",
  "version": "1.0.0",
  "identifier": "md.sime.opensime",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open SIME",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
