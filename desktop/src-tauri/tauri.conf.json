{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Open SIME",
  "version": "1.0.0",
  "identifier": "md.sime.opensime",
  "build": {
    "beforeDevCommand": "npm run start --prefix ../web",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run sidecar:build",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open SIME",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage"
    ],
    "category": "Education",
    "shortDescription": "Client neoficial pentru agenda.sime.md / Unofficial client for agenda.sime.md",
    "longDescription": "Open SIME este un client prietenos, rapid și privat pentru agenda electronică școlară agenda.sime.md, destinat elevilor și părinților.",
    "copyright": "Open SIME Contributors",
    "publisher": "Open SIME Contributors",
    "externalBin": [
      "binaries/open-sime-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": [
          "Romanian",
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/open-sime/open-sime-server": "binaries/open-sime-server-real-x86_64-unknown-linux-gnu"
        }
      }
    }
  }
}
