<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme after splash screen has dismissed -->
    <style name="Theme.OpenSime" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Pre-Compose window background uses branded blue to eliminate white flash -->
        <item name="android:windowBackground">@color/brand_blue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme for cold start (AndroidX core-splashscreen) -->
    <style name="Theme.OpenSime.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenSime</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
